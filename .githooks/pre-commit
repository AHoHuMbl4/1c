#!/usr/bin/env bash
# Тонкая обёртка гейта коммита. Ставится в .githooks/pre-commit установщиком
# (work/hooks/install-gates.sh), вместе с .claude/hooks/git-gate.sh. Содержания здесь нет
# намеренно.
#
# 🔴 ПОЧЕМУ ПУСТО. В каталог .githooks сессия писать МОЖЕТ (проверено пробой 03.08:
# `printf > .githooks/_probe.sh` проходит), а в `.claude/hooks/` — нет: среда закрывает его
# даже из оболочки. Значит логика гейта обязана лежать там, иначе исполнитель волен
# переписать собственный запрет — а правило, которое исполнитель может переписать, это
# пожелание с лишним шагом.
# Порча этой обёртки не проходит незамеченной: её сверяют оба сторожа —
# `.claude/hooks/git-gate.sh` (на стороне git) и `.claude/hooks/check-gates.sh` (в сессии).
#
# Зачем гейт вообще: 02.08 выяснилось, что PreToolUse-хуки Claude Code не зовутся в
# дочерних сессиях — гейты защищали ноль коммитов. Git зовёт pre-commit ВСЕГДА, кто бы ни
# коммитил: сессия, человек, Cursor.
#
# Включение на новом клоне (раз):  git config core.hooksPath .githooks
# Осознанный обход, когда проверка ошибается:  git commit --no-verify
set -uo pipefail
exec "$(git rev-parse --show-toplevel)/.claude/hooks/git-gate.sh" "$@"
