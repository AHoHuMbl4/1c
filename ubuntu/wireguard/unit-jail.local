# fail2ban на юните компании (Ubuntu 26.04): sshd-jail, стоковый фильтр
# (на релее 08.08 замерен рабочим: 18 failed засчитаны, бан брутфорсера
# подтверждён). Ставится на болванку — клоны наследуют (10.08, решение
# владельца: юниты получили внешний IP/исходящий NAT).
# ignoreip — свои: loopback, приватная сеть юнитов, релей, NAT основного
# сервера. Юнит доступен по ssh ТОЛЬКО через релей (10.1.1.4) — снаружи
# ssh на публичный IP под NAT-режимом не ходит, но порт 22 в ufw открыт,
# и брутфорс по публичному IP возможен (до ufw-ужесточения).
[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
ignoreip = 127.0.0.1/8 ::1 10.1.1.0/24 89.23.101.22 167.235.37.94
backend = systemd

[sshd]
enabled = true
