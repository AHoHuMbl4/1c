[Unit]
# КОНВЕЙЕР СВЕЖЕСТИ ИМЕНОВАННОЙ БАЗЫ: витрина (дельта из 1С) → поисковый слой.
# Один атомарный такт. Шаблон: `1c-serene-pipeline@ut_test` читает
# `/etc/1c-serene-pipeline-ut_test.env`.
#
# 🔴 ЗАЧЕМ ШАБЛОН. Прежний юнит был один и молча привязан к ПЕРВОЙ базе: `SERENEDB_DSN` в
# `/etc/1c-serene-sync.env` не содержит `dbname`, а умолчание кода — `postgres`. У боевой
# базы юнита не было вовсе, её такты гоняли руками — поэтому, когда 29.07 конвейер
# остановили, свежесть боевых данных пропала, и это никто не заметил четверо суток
# (`F001`). Ровно та же болезнь, что была у сервиса ответов и у шлюза OData.
#
# Имя экземпляра — имя базы движка, как у `1c-serene-ask@`: «какой такт какую базу
# обновляет» читается без справочника.
Description=1c-serene-pipeline — такт свежести базы %i (дельта из 1С + сборка слоя поиска)
After=network.target serenedb.service
Wants=serenedb.service
# 5 падений за час → failed, не петля. Таймер OnUnitInactiveSec=1min сам
# повторит; Restart= ловит быстрый отказ (форма EMBED_HOST), пока таймер молчит.
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=oneshot
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=3min
WorkingDirectory=/opt/1c-mcp-reports
# 🔴 ПОРЯДОК ЗНАЧИМ, последний слой перекрывает предыдущие:
#   1. общие ключи и пароли ролей;
#   2. эмбеддер — одно место на весь продукт (адрес, ключ, модель, размерность);
#   3. настройки ЭТОЙ базы: DSN с явным `dbname`, свой шлюз OData, свой каталог выгрузки.
# Разойдётся порядок — такт молча уйдёт в чужую базу: ошибки не будет ни на одном шаге,
# просто числа окажутся не те (`MAP §2`).
EnvironmentFile=-/etc/1c-mcp-reports.env
EnvironmentFile=/etc/1c-embed.env
EnvironmentFile=/etc/1c-serene-pipeline-%i.env
ExecStart=/opt/1c-mcp-reports/pipeline.sh
