[Unit]
# СБОРКА ПОИСКОВОГО СЛОЯ над витриной штатными средствами SereneDB (build.sh).
# Инкрементальная: эмбеддинг считается только новым и изменившимся строкам, поэтому такт —
# минуты, а не полный пересчёт.
#
# 🔴 28.07.2026: юнит переключён с `serene_search_build.py` на `build.sh`.
# Прежний питоновский сборщик при изменении состава корпуса СНОСИЛ таблицу и индекс
# (DROP+CREATE) — авария 03:55 28.07, корпус и индекс были потеряны и восстановлены
# вручную. `build.sh` пишет через `MERGE` и не роняет боевые объекты; вся работа с
# данными — внутри движка (п. 20 TARGET.md). Прежний ExecStart сохранён в
# 1c-serene-index.service.bak-20260728 на случай отката.
Description=1c-serene-index — сборка поискового слоя (корпус + BM25 + вектор + резолвер)
After=network.target serenedb.service
Wants=serenedb.service

[Service]
Type=oneshot
# Замок build.sh (flock) не даёт двум тактам наложиться; таймаут — чтобы зависший
# провайдер эмбеддинга не держал юнит вечно.
TimeoutStartSec=3600
WorkingDirectory=/opt/1c-mcp-reports
# 🔴 ПОРЯДОК ФАЙЛОВ ЗНАЧИМ, И ЕГО НЕЛЬЗЯ МЕНЯТЬ МЕСТАМИ.
# Обе переменные `SERENEDB_DSN` объявлены в обоих файлах, а systemd оставляет
# значение из ПОСЛЕДНЕГО. В `1c-mcp-reports.env` роль `serene_ro` — ей CREATE
# запрещён; в `1c-serene-sync.env` роль `postgres`. Когда sync-файл стоял первым,
# в сборку попадала read-only роль и она падала на `permission denied for schema
# public`. Файл `1c-mcp-reports.env` нужен ради ключей эмбеддера и токена шлюза,
# поэтому он идёт первым, а пишущую роль задаёт sync-файл.
EnvironmentFile=-/etc/1c-mcp-reports.env
EnvironmentFile=/etc/1c-serene-sync.env
ExecStart=/opt/1c-mcp-reports/build.sh
