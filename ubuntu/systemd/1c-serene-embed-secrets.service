[Unit]
# О5: персистентные секреты эмбеддера после каждого старта SereneDB.
# TEMPORARY-секреты такта (build.sh) живут на сессию; эти — для нативного ai_embed
# и досчёта вне такта (emb_<база>_N + qwen). Адреса/ключи — только /etc/1c-embed.env.
Description=1c-serene-embed-secrets — персистентные секреты эмбеддера
After=network.target serenedb.service
Wants=serenedb.service
StartLimitIntervalSec=1h
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
WorkingDirectory=/opt/1c-mcp-reports
EnvironmentFile=/etc/1c-embed.env
ExecStart=/opt/1c-mcp-reports/embed_secrets_install.sh

[Install]
WantedBy=multi-user.target
