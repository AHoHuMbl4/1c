[Unit]
Description=1c-serene-pipeline timer — по ГОТОВНОСТИ, не по часам (п. 17)

[Timer]
# 🔴 НЕ ПО РАСПИСАНИЮ, А ПО ГОТОВНОСТИ. `OnUnitInactiveSec` запускает следующий такт
# через минуту ПОСЛЕ того, как закончился предыдущий, — не по стенным часам. Свежесть
# = длительность такта, система подстраивается под размер базы сама. Минута между тактами
# — не ограничение свежести (её задаёт сам такт), а лишь пауза, чтобы не крутиться вхолостую.
OnBootSec=3min
OnUnitInactiveSec=1min
Persistent=true
AccuracySec=15s

[Install]
WantedBy=timers.target
