[Unit]
Description=1c-serene-pipeline timer для базы %i — по ГОТОВНОСТИ, не по часам (п. 17)

[Timer]
# 🔴 НЕ ПО РАСПИСАНИЮ, А ПО ГОТОВНОСТИ. `OnUnitInactiveSec` запускает следующий такт
# через минуту ПОСЛЕ того, как закончился предыдущий, — не по стенным часам. Свежесть
# = длительность такта, система подстраивается под размер базы сама. Минута между тактами
# — не ограничение свежести (её задаёт сам такт), а пауза, чтобы не крутиться вхолостую.
#
# 🔴 ТАЙМЕР ТЕПЕРЬ ПОД ПРИСМОТРОМ. [замер 02.08] остановившийся таймер не роняет ни один
# сервис — всё выглядит здоровым, — но работа стоит. Так 29.07 встала свежесть, и четверо
# суток этого никто не видел. Сторож `1c-bot-monitor` с 02.08 проверяет таймеры отдельно
# от сервисов именно поэтому.
OnBootSec=3min
OnUnitInactiveSec=1min
Persistent=true
AccuracySec=15s

[Install]
WantedBy=timers.target
