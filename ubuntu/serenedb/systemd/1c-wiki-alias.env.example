# ОБРАЗЕЦ настроек ОДНОГО прогона словаря синонимов (юнит 1c-wiki-alias@%i).
#
# Копируется в `/etc/1c-wiki-alias-<имя базы движка>.env`, права 600.
# Имя файла обязано совпадать с экземпляром: `systemctl start 1c-wiki-alias@<имя>`.
# Юнит: ubuntu/serenedb/systemd/1c-wiki-alias@.service —
#   EnvironmentFile=/etc/1c-mcp-reports.env
#   EnvironmentFile=-/etc/1c-wiki-alias-%i.env   ← этот слой (сильнее общего)
#   Environment=WIKI_ALIAS_MAX_SEC=0               ← полный прогон без wall-бюджета
#   ExecStart=…/wiki_alias.sh 0                    ← CAP=0 (все оставшиеся)
#
# Секретов модели здесь нет: ключ vLLM/OpenClaw — в генераторном HOME (G7a) или
# в общем контуре undebot. Здесь — DSN записи и ручки редакции/песочницы.

# ── запись в движок (обязательно) ───────────────────────────────────────────
# Роль rw. Общий /etc/1c-mcp-reports.env держит serene_ro — без этого слоя
# INSERT падает «permission denied» ([замер okna 27.08], комментарий юнита).
# dbname — имя базы движка (= %i юнита).
SERENEDB_DSN=host=127.0.0.1 port=7890 user=postgres dbname=ИМЯ_БАЗЫ

# ── таблицы редакции (дефолты скрипта = бой) ────────────────────────────────
# wiki_alias.sh:59–65. DDL — wiki_alias_init.sql (CREATE IF NOT EXISTS) в начале прогона.
# Песочница: свои имена, иначе правка боевого словаря / памяти столкновений (п.13).
ALIAS_TABLE=search_entity_alias
MEASURE_TABLE=search_measure_alias
# Память «слово уже разводили» (collision). G4 / f96f31d: :probe_table.
PROBE_TABLE=search_alias_probe

# ── бюджеты и пачки (wiki_alias.sh) ─────────────────────────────────────────
# Размер пачки сущностей/мер за один вызов модели. Умолч. скрипта 20; смоук P4 — 8.
WIKI_ALIAS_BATCH=20
# Периодическое доучивание (С5): 0 = выкл (боевые базы не меняются молча).
WIKI_ALIAS_REASK_EVERY=0
# Проход столкновений: 1 = вкл (умолч.), 0 = пропустить.
WIKI_ALIAS_COLLISIONS=1
# Предел кругов collision при MAX_SEC=0 (умолч. 40).
WIKI_ALIAS_COLLISION_ROUNDS=40
# Бюджет wall-секунд скрипта. Юнит ставит Environment=WIKI_ALIAS_MAX_SEC=0
# (полный прогон). Этот файл сильнее строки Environment= юнита ([замер okna 27.08]):
# иное значение здесь победит. 0 = без лимита.
WIKI_ALIAS_MAX_SEC=0
# CAP — аргумент ExecStart (`wiki_alias.sh 0`), не ключ этого файла.
# 0 = все оставшиеся сущности. Потолок числа — правка ExecStart или прямой вызов скрипта.
# Модель / thinking → alias_infer_gateway.py. Умолч. vllm/qwen/qwen3.8-27b (OpenRouter), thinking off.
WIKI_ALIAS_MODEL=vllm/qwen/qwen3.8-27b
WIKI_ALIAS_THINKING=off

# ── force-перегенерация живых строк (G1 / 0169688 + G5/G5b / b589496) ───────
# 0 штатно: MERGE пишет только в пустое; select — только без aliases.
# 1 — перегенерация ЖИВЫХ (select отдаёт всех + OFFSET; MERGE обновляет).
# 🔴 ТОЛЬКО по слову владельца. На боевых таблицах без snap — запрещено.
WIKI_ALIAS_FORCE=0

# ── рантайм вызова модели (G3/G3b / f96f31d) ─────────────────────────────────
# agent — канон (RUNBOOK §10.6-bis): `openclaw agent --local` читает params
#   каталога (temperature/seed/maxTokens/enable_thinking=false). Без них
#   reasoning-модель отвечает 200 без текста («No text output returned») —
#   живой замер okna 13.09, OpenRouter qwen/qwen3.8-27b.
# infer (`openclaw infer model run --local`) params каталога не применяет (G0) —
#   допустим только для провайдера без reasoning-вывода.
ALIAS_INFER_RUNTIME=agent
# Id агента OpenClaw при ALIAS_INFER_RUNTIME=agent (умолч. dict).
ALIAS_AGENT_ID=dict
# Потолок subprocess на один вызов, секунды (умолч. 1800). TimeoutExpired → exit 124.
ALIAS_AGENT_TIMEOUT_SEC=1800

# ── генераторный HOME OpenClaw (G3 песочница / G7a) ─────────────────────────
# Домашний каталог, НЕ путь к .openclaw. Конфиг:
#   $OPENCLAW_HOME/.openclaw/openclaw.json
# Ставится: ubuntu/openclaw/wiki_alias_setup_home.sh (задача G7a).
# При ALIAS_INFER_RUNTIME=agent задавать ОБЯЗАТЕЛЬНО. Пусто — вызов уйдёт в
# HOME бота (~/.openclaw): агент dict там есть и ответит, но сессии генератора
# смешаются с контуром бота (изоляция — G7, шлюз бота не трогаем).
# OPENCLAW_HOME=/var/lib/1c-wiki-alias-home
