# ОБРАЗЕЦ настроек отвечающего сервиса ОДНОЙ базы.
#
# Копируется установщиком в `/etc/1c-serene-ask-<имя базы движка>.env`, права 600.
# Имя файла обязано совпадать с именем экземпляра юнита: `1c-serene-ask@<имя базы>`.
# Секретов здесь нет и быть не должно — ключи и пароли ролей общие и лежат в
# `/etc/1c-mcp-reports.env`, токен сервиса — в `/etc/1c-serene-ask.env`.

# Чтение корпуса и индекса. `dbname` — единственное, что отличает базы; роль `serene_ro`
# одна на инстанс движка.
SERENEDB_DSN_RO=host=127.0.0.1 port=7890 user=serene_ro dbname=ИМЯ_БАЗЫ

# Резолвер «слово → значение измерения» ходит ОТДЕЛЬНОЙ ролью (positive control):
# SQL, который пишет модель, не должен дотягиваться до служебных эмбеддингов.
RESOLVER_DSN=host=127.0.0.1 port=7890 user=serene_resolver dbname=ИМЯ_БАЗЫ

# Порт этого экземпляра. У каждой базы свой; на него смотрит `ASK_URL` моста `1c-mcp-ask`.
ASK_LISTEN_PORT=8091

# Функция ранжирования инвертированного индекса.
# 🔴 Задаётся ЯВНО и ПОБАЗОВО. Пока значение лежало в общем файле, его переписывал
# `ab_scorer.py` (он гоняет варианты и оставляет последний, а не победителя) — и боевая
# база молча меняла скорер при первом же рестарте (`F008`). Побазовый файл убирает это
# столкновение по построению, а не запретом, который надо помнить.
# Значение меняется только замером на ЭТОЙ базе: разброс прибора ±1 верный ответ из
# десяти, поэтому «стало лучше» на одном ответе доказательством не является.
ASK_SCORER=lm_dirichlet

# Валюта денежных ответов. Перекрытие: когда в данных нет валюты — используется это.
# Пустая строка — единица не показывается (п. 12: не знаем — не пишем).
# Примеры: руб., $, €, lei, ₺
ASK_MONEY_UNIT=
