[Unit]
# ОТВЕЧАЮЩИЙ СЕРВИС ИМЕНОВАННОЙ БАЗЫ. Шаблон: `1c-serene-ask@ut_test` читает
# `/etc/1c-serene-ask-ut_test.env` и слушает порт, заданный там же.
#
# 🔴 ЗАЧЕМ ШАБЛОН. Баз 1С у клиента бывает несколько, и у каждой свой контур целиком:
# свой шлюз OData, своя база движка, свой сервис ответов. Пока юнит был один, боевая
# конфигурация второй базы существовала ТОЛЬКО в окружении процесса, поднятого руками
# (`F002`, `F110`): `SERENEDB_DSN_RO` не был записан ни в один файл, журнал уходил в файл
# под `/tmp` от завершённой сессии (`F150`), и ребут оставил бы бота без ответов —
# systemd поднял бы единственный юнит по ПЕРВОЙ базе, а мост стучится во вторую.
# То же самое уже стоило двух дефектов на шлюзе (см. `1c-odata-gateway@.service`).
#
# 🔴 ПОЧЕМУ ИМЯ ЭКЗЕМПЛЯРА — ИМЯ БАЗЫ ДВИЖКА. Оно не выдумано и не сокращено: `%i`
# совпадает с `dbname` в DSN того же файла, поэтому «какой юнит отвечает по какой базе»
# читается без справочника и без догадки.
Description=1c-serene-ask — ответы на вопросы по базе %i (поиск в SereneDB)
After=network.target serenedb.service
Wants=serenedb.service

[Service]
Type=simple
WorkingDirectory=/opt/1c-mcp-reports
# 🔴 ПОРЯДОК ЗНАЧИМ, последний слой перекрывает предыдущие:
#   1. общие ключи и пароли ролей (модель ответов, PGPASSWORD, RESOLVER_PW);
#   2. эмбеддер — ОДНО место на весь продукт (адрес, ключ, модель, размерность);
#   3. общие настройки сервиса (ASK_TOKEN) — одинаковы для всех баз;
#   4. настройки ЭТОЙ базы (DSN, порт, функция ранжирования) — они и решают.
# Разойдётся порядок — база подменится молча, без единой ошибки в журнале.
EnvironmentFile=/etc/1c-mcp-reports.env
EnvironmentFile=/etc/1c-embed.env
EnvironmentFile=-/etc/1c-serene-ask.env
EnvironmentFile=/etc/1c-serene-ask-%i.env
ExecStart=/opt/openclaw-mcp/venv/bin/python /opt/1c-mcp-reports/serene_ask.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
