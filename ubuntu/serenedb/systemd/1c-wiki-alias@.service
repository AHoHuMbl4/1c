[Unit]
# ПЕРЕСБОРКА СЛОВАРЯ СИНОНИМОВ СУЩНОСТЕЙ — ШАГ, КОТОРЫЙ ЗОВЁТ ШТАТНОГО АГЕНТА OPENCLAW.
#
# 🔴 Зачем юнит. `wiki_alias.sh` сам выбирает, как обратиться к агенту: уже бот — напрямую,
# root — `runuser`, иначе `sudo`. Рабочей сессии среда закрывает `sudo`, а профиль и токен
# шлюза лежат у пользователя бота с правами 0600 — то есть из сессии не работает ни одна из
# трёх веток, и каждая пересборка словаря упиралась в просьбу к владельцу «наберите команду».
# Юнит идёт от root, поэтому скрипт берёт ветку `runuser`, и сессия запускает его сама.
#
# Имя намеренно начинается на «1c-»: под это подпадает polkit-правило
# 50-claudedev-1c-units.rules, поэтому рабочий аккаунт стартует юнит без sudo:
#     systemctl start 1c-wiki-alias@ut_test
# Разрешение при этом не расширяется: стартует ровно один названный юнит.
#
# 🔴 Имя экземпляра — имя базы движка, как у `1c-serene-ask@` и `1c-odata-gateway@`: баз у
# клиента несколько, и у каждой свой словарь. Ни одного имени сущности и ни одного слова
# конкретной базы здесь нет — на чужой машине юнит работает так же.
Description=1c-wiki-alias — пересборка словаря синонимов сущностей базы %i (штатный агент OpenClaw)
After=network.target serenedb.service
Wants=serenedb.service

[Service]
Type=oneshot
# Ключи и пароль роли записи. 🔴 [замер okna 27.08] EnvironmentFile СИЛЬНЕЕ Environment=
# в systemd: общий /etc/1c-mcp-reports.env держит SERENEDB_DSN=user=serene_ro (только
# чтение) — строка Environment=SERENEDB_DSN=user=postgres НИКОГДА не побеждала, юнит
# падал «permission denied for table …» на каждом INSERT молча. Роль записи задаётся
# ТОЛЬКО последним слоем-файлом: побазовый /etc/1c-wiki-alias-%i.env несёт
# SERENEDB_DSN=host=127.0.0.1 port=7890 user=postgres dbname=<база> (как у pipeline).
EnvironmentFile=/etc/1c-mcp-reports.env
# Слой ЭТОГО прогона (обязателен для записи): `SERENEDB_DSN` (rw-роль), `ALIAS_TABLE`
# (собрать редакцию в копию), `WIKI_ALIAS_COLLISIONS`, `WIKI_ALIAS_MAX_SEC`,
# `WIKI_ALIAS_BATCH`. Нет файла — чтение serene_ro и отказ на записи.
EnvironmentFile=-/etc/1c-wiki-alias-%i.env
# 🔴 БЕЗ БЮДЖЕТА ВРЕМЕНИ ПО УМОЛЧАНИЮ. Внутри такта свежести шаг ограничен 120 с (п. 17),
# но это отдельный, ручной прогон: он собирает словарь целиком и не обязан укладываться в
# такт. Бюджет времени — только у скрипта (`WIKI_ALIAS_MAX_SEC`); systemd длительность
# не режет (см. TimeoutStartSec ниже).
Environment=WIKI_ALIAS_MAX_SEC=0
WorkingDirectory=/opt/1c-mcp-reports
# Fail-closed (D.1): падение compile solr в wiki_alias.sh → ненулевой exit → unit failed.
# Раньше solr-шаг глотался через «|| echo» — юнит оставался success при битом словаре.
ExecStart=/bin/bash /opt/1c-mcp-reports/wiki_alias.sh 0
# 🔴 [замер okna 27.08] TimeoutStartSec=7200 убил oneshot после 2h wall
# (`start operation timed out. Terminating.`, Result=timeout, ExecMainStatus=15),
# хотя словарь уже был дописан (258/258). На базе крупнее убийство пришлось бы
# на середину → молча наполовину собранный словарь (п. 13 TARGET.md). Длительность
# растёт с размером чужой базы — фиксированный потолок недопустим.
# Type=oneshot: TimeoutStartSec=infinity — канон после okna 27.08 (не путать с умолчанием DefaultTimeoutStartSec; 0 тоже = infinity).
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
