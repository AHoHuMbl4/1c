# /etc/1c-mcp-reports.env  (600, секреты НЕ в git — это шаблон)
DEEPSEEK_API_KEY=sk-xxxxxxxx
# Бот-отчёты ходят под READ-ONLY ролью serene_ro (запись БД физически запрещена) — см. setup_ro_role.sql.
SERENEDB_DSN=host=127.0.0.1 port=7890 user=serene_ro dbname=postgres
PGPASSWORD=CHANGE_ME_RANDOM
MCP_HOST=127.0.0.1
MCP_PORT=6015
# Директория для PNG-графиков. ОБЯЗАТЕЛЬНО под workspace бота (разрешённая директория медиа),
# иначе движок откажет в доставке файла клиенту. Подставить своего бот-юзера:
CHART_DIR=/home/undebot/.openclaw/workspace/charts
# Эмбеддер — свой контур (п. 16/20). Имена EMBED_* — действующие; см. serene_ask.py:
#   EMBED_BASE_URL / EMBED_API_KEY (основные), ALIBABA_* — только запасное чтение старых /etc.
# ~~ALIBABA_API_KEY / ALIBABA_EMBED_URL~~ — наследие DashScope, в шаблон новой раскатки не ставить.
# Адрес и модель задать явно (умолчания в коде зовут чужое облако — нельзя молча).
# Типично дублируется/живёт в /etc/1c-embed.env (его подключают 1c-serene-ask@ и такт).
# Конкретный URL/порт эмбеддера на стенде — не установлен офлайн в эту правку; подставить из 1c-embed.env.
EMBED_BASE_URL=http://127.0.0.1:<порт>/v1
EMBED_API_KEY=CHANGE_ME
EMBED_MODEL=Qwen3-Embedding-8B
EMBED_DIM=1024
# EMBED_API=openai
# EMBED_QUERY_PATH=/embed
