[Unit]
Description=Патч vLLM в openclaw.json undebot (allowlist + auth, бэкап)
After=network.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/1c-embed.env
EnvironmentFile=-/srv/1c/.claude/state/branch-alias.env
Environment=VLLM_API_KEY=${EMBED_API_KEY}
WorkingDirectory=/srv/1c/ubuntu/openclaw
ExecStart=/usr/sbin/runuser -u undebot --preserve-environment -- /bin/bash /srv/1c/ubuntu/openclaw/ensure_vllm_gateway.sh
ExecStartPost=/bin/systemctl start 1c-openclaw-gateway-restart.service

[Install]
WantedBy=multi-user.target
