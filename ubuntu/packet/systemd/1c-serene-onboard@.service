[Unit]
# Автоматический онбординг слота на юните компании (PLAN_PROD_LXC §8.1):
# снимок $metadata появился → контур агента (packet_config; на чистом юните —
# бутстреп из снимка, вариант А 10.08). Сборка слоя — НЕ здесь: до данных её
# обрывает штатный сторож пустого корпуса; её включает 1c-serene-firstbuild@
# по отметке .first-data от apply.
Description=онбординг слота %i на юните: контур агента по снимку $metadata
After=serenedb.service 1c-packet-server.service
Wants=serenedb.service

[Service]
Type=oneshot
TimeoutStartSec=infinity
# postgres — не выбор базы, а конвенция юнита: на копии dbname всегда postgres
# (PLAN_PROD_LXC §8.1: «бот-слой на копии поднимается одинаково, dbname всегда postgres»).
ExecStart=/opt/1c-packet/onboard_unit.sh %i postgres
