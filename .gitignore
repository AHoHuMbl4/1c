# Секреты — в git не попадают
credentials/

# Служебные файлы Claude Code (настройки проекта .claude/*.json — коммитим, runtime-артефакты — нет)
.claude/scheduled_tasks.lock

# 1С: локальные/временные артефакты
*.cfu
*.dt
1Cv8.1CD
1Cv8*.lgd
1Cv8*.lgf
*.tmp
*.log

# ОС/редакторы
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/
*.pyc

# Локальная сборка Windows-инструмента (готовый бинарь лежит в dist/)
windows/odata-setup/build/

# Отметка о прогоне золотого набора — локальная, у каждого своя
.claude/.golden-last-run

# Локальные разрешения Claude Code: в них оседают куски командных строк с путями
# к SSH-ключам. На машине разработки файл скрыт глобальным конфигом git, на сервере
# такого конфига нет (HANDOFF_CHECK_1 §8).
.claude/settings.local.json
.claude/hooks.log

# Выгрузка конфигурации 1С (`DumpConfigToFiles`, 03.08): 31 772 файла и 1,3 ГБ на базу.
# В git не кладётся по размеру — не потому, что неважна. Как её получить заново, записано
# в docs/INSTALL_LOG.md 03.08; лежит в work/config-dump/<база>/, архив рядом.
work/config-dump/

# Мусор от прогона test-hooks.sh: проба запускается из work/hooks и оставляет там свой .claude
work/hooks/.claude/

# Скачанный для разработки бинарь age (шифрование пакетов): в бой идёт пакет ОС
work/packet/bin/

# Комплекты баз пакетного транспорта (identity age, токены) — секреты, в git нельзя
work/packet/kit/

# Второе имя CLAUDE.md для Kimi Code — жёсткая ссылка, создаётся установщиком гейтов
AGENTS.md
