{
  "rules": {
    "sales_sum": {
      "sql": "SELECT round(sum(nums['Сумма']),2) FROM search_corpus WHERE src_table='accumulationregister_реализациятмц' AND doc_date >= '{from}' AND doc_date < '{to}'",
      "no_data": false
    },
    "clients_now": {
      "sql": "SELECT count(*) FROM search_corpus WHERE src_table='catalog_контрагенты' AND NOT coalesce(flags['IsFolder'],false) AND NOT coalesce(flags['DeletionMark'],false)",
      "no_data": false
    },
    "sku_count": {
      "sql": "SELECT count(*) FROM search_corpus WHERE src_table='catalog_номенклатура' AND NOT coalesce(flags['IsFolder'],false) AND NOT coalesce(flags['DeletionMark'],false)",
      "no_data": false
    },
    "buyers_12m": {
      "sql": "SELECT count(DISTINCT refs_map['Контрагент']) FROM search_corpus WHERE src_table='accumulationregister_реализациятмц' AND nums['Сумма'] >= 0 AND doc_date >= '{from}' AND doc_date < '{to}'",
      "no_data": false
    },
    "month_buyers": {
      "sql": "SELECT count(DISTINCT refs_map['Контрагент']) FROM search_corpus WHERE src_table='accumulationregister_реализациятмц' AND nums['Сумма'] >= 0 AND doc_date >= '{from}' AND doc_date < '{to}'",
      "no_data": false
    },
    "org_count": {
      "sql": "SELECT count(*) FROM search_corpus WHERE src_table='catalog_организации'",
      "no_data": false
    },
    "bank_count": {
      "sql": "SELECT count(*) FROM search_corpus WHERE src_table='catalog_банки'",
      "no_data": false
    },
    "val_count": {
      "sql": "SELECT count(*) FROM search_corpus WHERE src_table='catalog_валюты'",
      "no_data": false
    },
    "stores_count": {
      "sql": "SELECT count(*) FROM search_corpus WHERE src_table='catalog_местахранения'",
      "no_data": false
    },
    "reg_rows": {
      "sql": "SELECT count(*) FROM search_corpus WHERE src_table='{table}'",
      "no_data": false
    },
    "reg_rows_30d": {
      "sql": "SELECT count(*) FROM search_corpus WHERE src_table='{table}' AND doc_date >= '{from}' AND doc_date < '{to}'",
      "no_data": false
    },
    "no_stock": {
      "no_data": true
    }
  },
