#!/usr/bin/env bash
# Тонкая обёртка второго захода гейта: проверки, закрываемые пометкой в сообщении.
#
# 🔴 Зачем отдельный хук. `pre-commit` вызывается ДО того, как git получил сообщение
# (man githooks), поэтому «Доки: <раздел>» и «Числа: …» там не видны — в COMMIT_EDITMSG
# лежит текст прошлого коммита. `commit-msg` получает файл сообщения первым доводом.
#
# Содержания здесь нет намеренно: логика живёт в защищённом .claude/hooks/git-gate.sh,
# сюда сессия писать может. Целость обёртки сверяет hook_guard_armed.
set -uo pipefail
exec "$(git rev-parse --show-toplevel)/.claude/hooks/git-gate.sh" "$1"
